rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // Student's own profile photo.
    match /users/{uid}/profile/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Admin-managed content: notes, question assets, test assets.
    match /notes/{examId}/{subjectId}/{chapterId}/{topicId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /questions/{questionId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /tests/{testId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /uploads/{fileName} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
